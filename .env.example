# Kopier denne fila til .env i prosjektroten og fyll inn verdien.
# .env er gitignorert og skal aldri committes; denne fila viser bare hvilke
# variabler som trengs.

# API-noekkel til EODHD, som leverer sluttkursene. Den eneste variabelen
# koden leser - src/fetch_prices.py henter den, og ingenting annet i
# prosjektet bruker kvote.
#
# Skaffes ved aa registrere en gratiskonto paa https://eodhd.com og kopiere
# noekkelen fra dashbordet. Gratisnivaaet gir 20 API-kall i doegnet, og en
# full henting av de 15 symbolene bruker 15 av dem.
EODHD_API_KEY=
