# Kopier denne fila til .env i prosjektroten og fyll inn verdiene.
# .env er gitignorert og skal aldri committes; denne fila viser bare hvilke
# variabler som trengs.
#
# Det er seks variabler aa sette i .env: EODHD_API_KEY, OSE_KI_TJENESTE,
# OSE_KI_OLLAMA_URL og de tre noeklene til KI-tjenestene. Hentingen trenger
# EODHD_API_KEY. Uten OSE_KI_TJENESTE gjelder lokal, og OSE_KI_OLLAMA_URL
# trengs bare naar hentingen kjoeres med uv og Ollama ikke svarer paa
# standardadressen. En noekkel til en KI-tjeneste trengs bare naar
# OSE_KI_TJENESTE velger den.

# API-noekkel til EODHD, som leverer sluttkursene. src/fetch_prices.py
# henter den, og ingenting annet i prosjektet bruker kvote.
#
# Skaffes ved aa registrere en gratiskonto paa https://eodhd.com og kopiere
# noekkelen fra dashbordet. Gratisnivaaet gir 20 API-kall i doegnet, og en
# full henting bruker 16 av de 20 kallene: ett for hver av de 15 aksjene og
# ett for hovedindeksen.
EODHD_API_KEY=

# KI-teksten i aksjedetaljen (story 10.2, FR-608). av: ingen KI-tekst, og
# hentingen gaar som foer. lokal: Gemma i Ollama paa maskinen, se «Den lokale
# modellen» i README-en. Uten variabelen gjelder lokal. gemini, anthropic og
# openai bruker din egen noekkel under (story 10.7), se «Egen noekkel til
# Gemini, Anthropic eller OpenAI» i README-en. Da sendes grunnlaget til
# tjenesten du har valgt, og det kan koste hos dem.
OSE_KI_TJENESTE=av

# Adressen til Ollama naar hentingen kjoeres med uv. Standard er
# http://127.0.0.1:11434. I docker compose er den alltid http://ollama:11434.
# OSE_KI_OLLAMA_URL=http://127.0.0.1:11434

# Din egen noekkel til tjenesten OSE_KI_TJENESTE velger. Bare den ene trengs.
# Noekkelen skal aldri deles, og .env committes aldri. Ingen noekkel foelger
# med appen eller repoet.
OSE_KI_GEMINI_NOKKEL=
OSE_KI_ANTHROPIC_NOKKEL=
OSE_KI_OPENAI_NOKKEL=
